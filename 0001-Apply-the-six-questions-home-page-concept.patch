+/* Home page: "six questions" concept.
+   Uses the theme variables from base.css, so it works in light and dark mode. */
+
+.home-hero { padding: 3.5rem 0 2.5rem; }
+.home-hero h1 {
+  font-family: var(--font-heading);
+  font-size: clamp(2.2rem, 5vw, 3.6rem);
+  font-weight: 800;
+  line-height: 1.12;
+  color: var(--primary);
+  max-width: 16ch;
+  margin: 0;
+}
+.home-hero .lead { margin-top: 1.25rem; max-width: 52ch; }
+
+.home-questions {
+  margin-top: 3rem;
+  border-top: 2px solid var(--primary);
+}
+.home-question {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 0.5rem 2rem;
+  align-items: center;
+  padding: 1.4rem 0.75rem 1.4rem 0.25rem;
+  border-bottom: 1px solid var(--border);
+  color: inherit;
+  text-decoration: none;
+  transition: background-color var(--transition-speed) ease;
+}
+.home-question:hover,
+.home-question:focus-visible { background: color-mix(in srgb, var(--teal) 10%, transparent); }
+.home-question h3 {
+  font-family: var(--font-heading);
+  font-size: clamp(1.25rem, 2.4vw, 1.7rem);
+  font-weight: 700;
+  color: var(--text);
+  margin: 0;
+  line-height: 1.2;
+}
+.home-question p { grid-column: 1; font-size: 0.98rem; color: var(--text-muted); margin: 0; }
+.home-question .home-try {
+  grid-column: 2; grid-row: 1 / span 2;
+  font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem;
+  color: var(--teal); white-space: nowrap;
+}
+
+/* One orchestrated moment on load. */
+@media (prefers-reduced-motion: no-preference) {
+  .home-question { animation: home-settle 620ms ease both; }
+  .home-question:nth-child(2) { animation-delay: 70ms; }
+  .home-question:nth-child(3) { animation-delay: 140ms; }
+  .home-question:nth-child(4) { animation-delay: 210ms; }
+  .home-question:nth-child(5) { animation-delay: 280ms; }
+  .home-question:nth-child(6) { animation-delay: 350ms; }
+}
+@keyframes home-settle {
+  from { opacity: 0; transform: translateX(-8px); }
+  to   { opacity: 1; transform: none; }
+}
+
+.home-roles { padding: 4.5rem 0 3rem; }
+.home-roles h2 {
+  font-family: var(--font-heading);
+  font-size: clamp(1.6rem, 3vw, 2.2rem);
+  color: var(--primary);
+  max-width: 22ch;
+  margin: 0;
+}
+.home-roles-grid {
+  margin-top: 2.5rem;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 2.5rem;
+}
+.home-role svg { width: 96px; height: 96px; display: block; margin-bottom: 1rem; color: var(--primary); }
+.home-role svg .accent { stroke: var(--teal); }
+.home-role h3 { font-family: var(--font-heading); font-size: 1.2rem; color: var(--primary); margin: 0 0 0.5rem; }
+.home-role p { font-size: 0.98rem; color: var(--text-muted); margin: 0; max-width: 40ch; }
+
+.home-strip {
+  padding: 2.75rem 0;
+  background: color-mix(in srgb, var(--primary) 10%, var(--bg));
+  border-top: 1px solid var(--border);
+  border-bottom: 1px solid var(--border);
+}
+.home-strip .container { display: grid; grid-template-columns: 1fr 1.3fr; gap: 2.5rem; align-items: start; }
+.home-strip h2 { font-family: var(--font-heading); font-size: 1.6rem; color: var(--primary); margin: 0; }
+.home-strip p + p { margin-top: 0.85rem; }
+
+.home-notice {
+  margin: 2.5rem 0 0;
+  padding: 1rem 1.2rem;
+  font-size: 0.92rem;
+  background: var(--surface);
+  border-left: 4px solid var(--teal);
+  border-radius: var(--radius-input);
+  max-width: 70ch;
+}
+
+@media (max-width: 820px) {
+  .home-roles-grid { grid-template-columns: 1fr; gap: 2rem; }
+  .home-strip .container { grid-template-columns: 1fr; }
+}
+@media (max-width: 560px) {
+  .home-question { grid-template-columns: 1fr; }
+  .home-question .home-try { grid-column: 1; grid-row: auto; }
+}
